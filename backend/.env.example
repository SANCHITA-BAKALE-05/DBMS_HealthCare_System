# ============================================================
# HEALTHCARE SYSTEM - BACKEND ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your actual values.
# Never commit the real .env file to version control.
# ============================================================

# --- Server ---
PORT=5000

# --- MySQL Database ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password
DB_NAME=healthcare_system

# --- JWT ---
# Replace with a long random secret string (min 32 characters)
JWT_SECRET=your_super_secret_jwt_key_replace_this
JWT_EXPIRES_IN=7d

# --- Python ML Service ---
# Will be used in Phase 11
ML_SERVICE_URL=http://localhost:5001
